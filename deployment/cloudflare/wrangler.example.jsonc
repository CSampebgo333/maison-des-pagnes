{
  "name": "maison-du-faso-dan-fani",
  "main": "../../dist/server/index.js",
  "compatibility_date": "2026-10-18",
  "assets": {"directory": "../../dist/client", "binding": "ASSETS", "run_worker_first": true, "not_found_handling": "single-page-application"},
  "d1_databases": [{"binding": "DB", "database_name": "maison-faso", "database_id": "REPLACE_WITH_DATABASE_ID", "migrations_dir": "../../drizzle"}],
  "r2_buckets": [{"binding": "BUCKET", "bucket_name": "maison-faso-files"}],
  "vars": {
    "AUTH_MODE": "cloudflare",
    "CATALOGUE_ADMIN_EMAIL": "cl.sampebgo@gmail.com",
    "ACCESS_ISSUER": "https://REPLACE.cloudflareaccess.com",
    "ACCESS_AUD": "REPLACE_WITH_ACCESS_APPLICATION_AUD"
  }
}

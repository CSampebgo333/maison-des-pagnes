{
  "name": "maison-du-faso-dan-fani",
  "routes": [
    { "pattern": "fasodanfani.shop", "custom_domain": true }
  ],
  "main": "../../dist/server/index.js",
  "compatibility_date": "2026-10-18",
  "assets": {
    "directory": "../../dist/client",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "maison-faso",
      "database_id": "REPLACE_WITH_DATABASE_ID",
      "migrations_dir": "../../drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "maison-faso-files"
    }
  ],
  "vars": {
    "AUTH_MODE": "cloudflare",
    "CATALOGUE_ADMIN_EMAIL": "REPLACE_WITH_ADMIN_EMAIL",
    "ACCESS_ISSUER": "https://REPLACE.cloudflareaccess.com",
    "ACCESS_AUD": "REPLACE_WITH_ACCESS_APPLICATION_AUD",
    "BACKUP_CRON_ENABLED": "1",
    "WHATSAPP_ENABLED": "0"
  },
  "triggers": {
    "crons": [
      "0 3 * * *",
      "*/5 * * * *"
    ]
  }
}
